# Copy this file to .env and fill in real values before running
# `docker compose up` in anything beyond local experimentation.

# Used to sign session tokens. Generate a real one with, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value

# Postgres password (also used to build the api's DATABASE_URL automatically)
POSTGRES_PASSWORD=change-me-too

# Web Push (browser notifications for group-event invites/resolutions).
# Generate a real keypair with:
#   npx web-push generate-vapid-keys
# The built-in fallback is a real, working keypair -- but it's public in
# this repo's history, so anyone could send push messages "as" your
# deployment if you don't replace it. VAPID_SUBJECT should be a mailto:
# or https: URL the push services can use to contact you if needed.
VAPID_PUBLIC_KEY=change-me-too
VAPID_PRIVATE_KEY=change-me-too
VAPID_SUBJECT=mailto:you@example.com
